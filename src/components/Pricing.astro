---
import CommissionButton from './CommissionButton.astro';
import { complexities, sizes, gbp } from '../data/pricing';
---

<div class="pricing reveal">
  <div class="pricing__scroll">
    <table class="pricing__table">
      <caption class="sr-only">Mural price guide by width and design complexity</caption>
      <thead>
        <tr>
          <th scope="col">Approx. width</th>
          {
            complexities.map((c) => (
              <th scope="col">
                <span class="pricing__level">{c.label}</span>
                <span class="pricing__hint">{c.hint}</span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          sizes.map((s) => (
            <tr>
              <th scope="row">{s.label}</th>
              {s.prices.map((p) => (
                <td>
                  <span class="pricing__from">from</span> {gbp(p)}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <ul class="pricing__notes">
    <li>Includes a design concept, one round of changes, all paints and materials.</li>
    <li>Most murals are painted in a single day; large detailed walls take two or three.</li>
    <li>Travel within London &amp; Kent is included; further afield is quoted individually.</li>
    <li>Commercial spaces, high walls and out-of-hours work are quoted individually.</li>
    <li>A 30% deposit secures your dates; the balance is due on completion.</li>
  </ul>

  <div class="center">
    <CommissionButton label="Get your exact quote" />
  </div>
</div>

<style>
  .pricing__scroll {
    overflow-x: auto;
    margin: 48px 0 32px;
  }

  .pricing__table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    text-align: left;
  }

  th,
  td {
    padding: 18px 16px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  tbody th,
  tbody td {
    vertical-align: middle;
  }

  thead th {
    border-bottom-color: var(--ink);
    font-weight: 400;
  }

  thead th:first-child,
  tbody th {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--muted);
    white-space: nowrap;
  }

  .pricing__level {
    display: block;
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .pricing__hint {
    display: block;
    margin-top: 4px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  td {
    font-family: var(--serif);
    font-size: 1.5rem;
    white-space: nowrap;
  }

  .pricing__from {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  tbody tr:hover td {
    color: var(--accent);
  }

  .pricing__notes {
    max-width: 760px;
    margin: 0 auto 40px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .pricing__notes li::before {
    content: '~ ';
    color: var(--accent);
  }
</style>
