---
// A clickable artwork tile that opens in the lightbox.
// mode="still"  -> image (with a play badge if the work has a video)
// mode="reel"   -> muted autoplaying vertical video (plays only while on screen)
import type { Work } from '../data/works';
import { asset } from '../data/site';

interface Props {
  work: Work;
  mode?: 'still' | 'reel';
  showTitle?: boolean;
  ratio?: string;
  class?: string;
  eager?: boolean;
}

const { work, mode = 'still', showTitle = false, ratio, class: className, eager = false } = Astro.props;
const src = asset(work.image);
const video = work.video ? asset(work.video) : undefined;
const poster = work.video ? asset(work.video.replace(/\.mp4$/, '.webp')) : src;
const aspect = ratio ?? `${work.width} / ${work.height}`;
---

<figure
  class:list={['tile', `tile--${mode}`, className]}
  data-lightbox
  data-src={mode === 'reel' ? poster : src}
  data-video={video}
  data-caption={work.caption}
  data-alt={work.alt}
  data-link={work.instagram}
  data-category={work.category}
  tabindex="0"
  role="button"
  aria-label={`Open “${work.title}”${video ? ' (video)' : ''}`}
>
  <div class="tile__media" style={`aspect-ratio: ${aspect}`}>
    {
      mode === 'reel' && video ? (
        <video src={video} poster={poster} muted loop playsinline preload="none" data-autoplay aria-label={work.alt} />
      ) : (
        <img
          src={src}
          alt={work.alt}
          width={work.width}
          height={work.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      )
    }
    {
      video && (
        <span class="tile__play" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      )
    }
  </div>
  {
    showTitle && (
      <figcaption class="tile__caption">
        <span class="tile__title">{work.title}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .tile {
    margin: 0;
    outline-offset: 4px;
  }

  .tile__media {
    position: relative;
    overflow: hidden;
    background: var(--line);
  }

  .tile__media img,
  .tile__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.6s;
  }

  .tile:hover .tile__media img,
  .tile:hover .tile__media video {
    transform: scale(1.04);
  }

  .tile__play {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(250, 248, 244, 0.88);
    color: var(--ink);
  }

  .tile__caption {
    padding-top: 12px;
  }

  .tile__title {
    font-family: var(--serif);
    font-size: 1.3rem;
  }
</style>
