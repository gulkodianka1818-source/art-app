---
// One shared <dialog>; any element with data-lightbox opens it.
// Attributes: data-src (image), data-video (mp4, optional), data-caption, data-link (Instagram).
---

<dialog class="lightbox" aria-label="Artwork preview">
  <button class="lightbox__close" type="button" aria-label="Close">×</button>
  <div class="lightbox__stage"></div>
  <p class="lightbox__caption">
    <span class="lightbox__text"></span>
    <a class="lightbox__link" target="_blank" rel="noopener">View on Instagram</a>
  </p>
</dialog>

<style is:global>
  .lightbox {
    width: min(92vw, 980px);
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--dark-ink);
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(20, 18, 16, 0.92);
  }

  .lightbox__stage {
    display: grid;
    place-items: center;
  }

  .lightbox__stage img,
  .lightbox__stage video {
    max-width: 100%;
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    background: #000;
  }

  .lightbox__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    margin: 16px 0 0;
    text-align: center;
    font-size: 0.95rem;
    color: var(--dark-muted);
  }

  .lightbox__link {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dark-ink);
  }

  .lightbox__close {
    position: fixed;
    top: 12px;
    right: 16px;
    width: 48px;
    height: 48px;
    border: 0;
    background: none;
    color: #fff;
    font-size: 2.2rem;
    font-weight: 300;
    line-height: 1;
    cursor: pointer;
  }

  [data-lightbox] {
    cursor: zoom-in;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const stage = dialog.querySelector<HTMLElement>('.lightbox__stage')!;
  const text = dialog.querySelector<HTMLElement>('.lightbox__text')!;
  const link = dialog.querySelector<HTMLAnchorElement>('.lightbox__link')!;

  function open(el: HTMLElement) {
    const { src = '', video, caption = '', link: href, alt = '' } = el.dataset;
    stage.replaceChildren();
    if (video) {
      const v = document.createElement('video');
      Object.assign(v, { src: video, poster: src, controls: true, autoplay: true, muted: true, loop: true, playsInline: true });
      stage.append(v);
    } else {
      const img = document.createElement('img');
      Object.assign(img, { src, alt });
      stage.append(img);
    }
    text.textContent = caption;
    link.hidden = !href;
    if (href) link.href = href;
    dialog.showModal();
  }

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
    if (!el) return;
    e.preventDefault();
    open(el);
  });

  document.addEventListener('keydown', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('[data-lightbox]');
    if (el && (e.key === 'Enter' || e.key === ' ')) {
      e.preventDefault();
      open(el);
    }
  });

  const close = () => dialog.close();
  dialog.querySelector('.lightbox__close')!.addEventListener('click', close);
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  dialog.addEventListener('close', () => stage.replaceChildren());
</script>
