---
// NOTE: answers are a first draft — Diana should review prices/timings/materials.
const faqs = [
  {
    q: 'Which areas do you cover?',
    a: 'I paint murals across London and Kent. For projects further afield, just mention your location in the commission form and we’ll work it out together.',
  },
  {
    q: 'How much does a mural cost?',
    a: 'Small, simple designs start from £250, illustrated children’s room murals typically from £500–£1,000, and large detailed or 3D walls from £1,000–£1,800+. See the price guide above, then send your wall size and idea through the form for an exact fixed quote.',
  },
  {
    q: 'Do you take a deposit?',
    a: 'Yes — a 30% deposit secures your dates, and the balance is due once the mural is finished and you’re happy with it.',
  },
  {
    q: 'How long does it take?',
    a: 'Smaller designs can be finished in a day or two, while large, highly detailed walls may take a week or more. You’ll get a clear timeline together with your quote.',
  },
  {
    q: 'Will I see the design before you start painting?',
    a: 'Yes. I prepare a concept based on your ideas, room and colour palette, and we refine it together before any paint touches the wall.',
  },
  {
    q: 'Is it safe for a nursery or child’s room?',
    a: 'I use quality water-based interior paints and keep the room ventilated while I work. Once everything is fully dry the room is ready to enjoy again.',
  },
  {
    q: 'Do I need to empty the room?',
    a: 'No — I only need clear access to the wall. I cover floors and furniture nearby and leave the space tidy at the end of each day.',
  },
  {
    q: 'Do you paint portraits and canvases too?',
    a: 'Absolutely. I take commissions for graphite and colour portraits from your photographs, as well as original paintings — and occasionally have finished pieces available to buy.',
  },
];
---

<div class="faq">
  {
    faqs.map((f) => (
      <details class="faq__item">
        <summary>
          <span>{f.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
})} />

<style>
  .faq {
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.3;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.3s;
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  details[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  details p {
    margin: 0;
    padding: 0 40px 24px 0;
    color: var(--ink-soft);
  }
</style>
