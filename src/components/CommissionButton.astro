---
// The key call-to-action: opens the commission Google Form in a new tab.
import { site } from '../data/site';

interface Props {
  label?: string;
  size?: 'sm' | 'md';
  class?: string;
}

const { label = 'Commission a mural', size = 'md', class: className } = Astro.props;
---

<a
  class:list={['btn', 'btn--cta', size === 'sm' && 'btn--sm', className]}
  href={site.commissionFormUrl}
  target="_blank"
  rel="noopener"
  data-commission
>
  {label}
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M7 17 17 7M9 7h8v8"></path>
  </svg>
</a>

<style>
  .btn--sm {
    min-height: 40px;
    padding: 0 1.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }
</style>
