---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { site, asset } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = site.title, description = site.description, image = 'og-image.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(asset(image), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${Astro.site}#diana`,
      name: site.name,
      jobTitle: site.role,
      url: Astro.site?.toString(),
      image: ogImage.toString(),
      sameAs: [site.instagram],
      workLocation: site.areas.map((name) => ({ '@type': 'Place', name })),
    },
    {
      '@type': 'ProfessionalService',
      name: `${site.name} — Hand-Painted Murals`,
      description: site.description,
      url: Astro.site?.toString(),
      image: ogImage.toString(),
      founder: { '@id': `${Astro.site}#diana` },
      areaServed: site.areas.map((name) => ({ '@type': 'AdministrativeArea', name })),
      address: { '@type': 'PostalAddress', addressRegion: 'London & Kent', addressCountry: 'GB' },
      sameAs: [site.instagram],
      knowsAbout: ['Murals', 'Children’s room murals', 'Nursery murals', 'Trompe-l’œil', 'Portrait drawing', 'Painting'],
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#faf8f4" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Lightbox />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Fade sections in as they scroll into view.
      const revealIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              revealIO.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => revealIO.observe(el));

      // Muted inline videos only play while visible (saves data and CPU).
      const videoIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting && e.intersectionRatio >= 0.2) v.play().catch(() => {});
            else v.pause();
          }
        },
        { threshold: [0, 0.2, 0.5, 1] },
      );
      if (!reduceMotion) {
        document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => videoIO.observe(v));
      }
    </script>
  </body>
</html>
