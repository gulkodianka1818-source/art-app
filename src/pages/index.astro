---
import Base from '../layouts/Base.astro';
import CommissionButton from '../components/CommissionButton.astro';
import WorkTile from '../components/WorkTile.astro';
import Faq from '../components/Faq.astro';
import Pricing from '../components/Pricing.astro';
import { site, asset } from '../data/site';
import { bySlug } from '../data/works';

const strip = [
  'elephant-rainbow-nursery',
  'hulk-fist-3d-mural',
  'portrait-painting',
  'savanna-trees',
  'alice-in-wonderland-window',
  'mother-and-baby',
  'rainbow-arch-process',
  'storybook-tree',
  'blue-bloom',
].map(bySlug);

const processReels = ['wall-preparation', 'elephant-mural-process', 'rainbow-arch-process', 'hulk-bedroom'].map(bySlug);

const steps = [
  {
    title: 'Tell me about your wall',
    text: 'Fill in the short commission form with the room, rough wall size, a few photos and the ideas or characters you love.',
  },
  {
    title: 'Concept & quote',
    text: 'I sketch a design around your space and colours, and send it with a clear quote and timeline before any paint goes on.',
  },
  {
    title: 'Preparing the wall',
    text: 'Surfaces are filled, sanded and primed, and floors and furniture are protected, so the finished mural lasts for years.',
  },
  {
    title: 'Painting & reveal',
    text: 'Everything is painted by hand, layer by layer, on site. Then comes my favourite part — seeing the room come to life.',
  },
];
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <span class="eyebrow">Hand-painted murals · {site.location}</span>
        <h1>Hand-painted murals that turn blank walls into <em>little worlds</em></h1>
        <p class="hero__sub">
          Bespoke wall art for children’s rooms, nurseries, homes and businesses — from gentle storybook scenes to
          jaw-dropping 3D illusions, each one painted entirely by hand.
        </p>
        <div class="btn-row">
          <CommissionButton />
          <a class="btn btn--ghost" href={asset('portfolio/')}>View portfolio</a>
        </div>
      </div>
      <div class="hero__media">
        <div class="frame frame--arch hero__frame">
          <video
            src={asset('media/video/hero-hulk-timelapse.mp4')}
            poster={asset('media/video/hero-hulk-timelapse.webp')}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            data-autoplay
            aria-label="Time-lapse of Diana painting a 3D fist bursting through a grey wall"></video>
        </div>
        <p class="hero__note">From grey wall to 3D illusion — hand-painted, sped up.</p>
      </div>
    </div>
  </section>

  <!-- ============ INTRO + STRIP ============ -->
  <section class="section intro" id="welcome">
    <div class="wrap center reveal">
      <h2>Art that grows with your home</h2>
      <p class="lede">
        A painted wall changes how a room feels. It can make a nursery calm and dreamy, give a little superhero a
        bedroom worth bragging about, or turn a plain shop window into a story people stop to look at.
      </p>
      <p class="lede">
        I design every piece around your space, your colours and the people who live in it, and then paint it by hand,
        right there on your wall.
      </p>
    </div>

    <div class="strip reveal" aria-label="Selected work">
      {strip.map((w) => <WorkTile work={w} ratio="3 / 4" class="strip__item" />)}
    </div>

    <div class="center">
      <a class="btn btn--ghost" href={asset('portfolio/')}>View full portfolio</a>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section section--alt" id="murals">
    <div class="wrap split reveal">
      <div class="split__text">
        <span class="eyebrow">Children’s rooms &amp; nurseries</span>
        <h2>Murals for little dreamers</h2>
        <p>
          Sleepy elephants, rainbow arches, storybook trees and favourite characters — soft, hand-painted scenes that turn
          a nursery or playroom into a space your child will never want to leave.
        </p>
        <p class="muted">Designed to suit your colour palette and painted to last as your little one grows.</p>
        <div class="btn-row">
          <CommissionButton label="Plan a nursery mural" variant="ghost" />
        </div>
      </div>
      <div class="split__media">
        <WorkTile work={bySlug('elephant-rainbow-nursery')} ratio="4 / 5" />
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap split split--reverse reveal">
      <div class="split__text">
        <span class="eyebrow">3D &amp; statement walls</span>
        <h2>Illusions that stop people in their tracks</h2>
        <p>
          Trompe-l’œil cracks, fists smashing through plaster and scenes that seem to step out of the wall. Bold,
          playful pieces for bedrooms, games rooms, cafés and studios.
        </p>
        <div class="btn-row">
          <CommissionButton label="Commission a statement wall" variant="ghost" />
        </div>
      </div>
      <div class="split__media">
        <WorkTile work={bySlug('hulk-fist-3d-mural')} mode="reel" ratio="4 / 5" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split reveal">
      <div class="split__text">
        <span class="eyebrow">Homes, businesses &amp; windows</span>
        <h2>Walls with a story</h2>
        <p>
          From calm acacia silhouettes in a living room to an Alice in Wonderland window display, I create murals and
          window art for homes, shops, cafés, schools and offices across London and Kent.
        </p>
        <div class="btn-row">
          <CommissionButton label="Discuss your project" variant="ghost" />
        </div>
      </div>
      <div class="split__media duo">
        <WorkTile work={bySlug('savanna-trees')} ratio="3 / 4" />
        <WorkTile work={bySlug('alice-in-wonderland-window')} ratio="3 / 4" />
      </div>
    </div>
  </section>

  <section class="section section--alt" id="artwork">
    <div class="wrap split split--reverse reveal">
      <div class="split__text">
        <span class="eyebrow">Portraits &amp; original artwork</span>
        <h2>Portraits that feel like the people you love</h2>
        <p>
          Commissioned portraits in fine graphite hatching or full colour, drawn from your favourite photographs — a
          newborn’s first weeks, a couple, a family, a much-loved pet. A gift that becomes an heirloom.
        </p>
        <div class="btn-row">
          <CommissionButton label="Commission a portrait" variant="ghost" />
        </div>
      </div>
      <div class="split__media duo">
        <WorkTile work={bySlug('mother-and-baby')} ratio="3 / 4" />
        <WorkTile work={bySlug('portrait-painting')} ratio="3 / 4" />
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section" id="process">
    <div class="wrap">
      <div class="center reveal">
        <span class="eyebrow">How it works</span>
        <h2>From blank wall to finished mural</h2>
        <p class="lede">A simple, relaxed process — you’ll know exactly what to expect at every stage.</p>
      </div>

      <ol class="steps reveal">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="reels reveal">
        {processReels.map((w) => <WorkTile work={w} mode="reel" ratio="9 / 16" showTitle />)}
      </div>

      <div class="center">
        <CommissionButton label="Start your commission" />
      </div>
    </div>
  </section>

  <!-- ============ PRICES ============ -->
  <section class="section section--alt" id="prices">
    <div class="wrap">
      <div class="center reveal">
        <span class="eyebrow">Price guide</span>
        <h2>What does a mural cost?</h2>
        <p class="lede">
          Every wall is different, so these are starting prices to help you plan. Choose the size and style in the
          commission form and I’ll send an exact, fixed quote — no surprises.
        </p>
      </div>
      <Pricing />
    </div>
  </section>

  <!-- ============ QUOTE ============ -->
  <section class="quote section--dark">
    <video
      class="quote__bg"
      src={asset('media/video/princess-room-reveal.mp4')}
      poster={asset('media/video/princess-room-reveal.webp')}
      muted
      loop
      playsinline
      preload="none"
      data-autoplay
      aria-hidden="true"></video>
    <blockquote class="wrap center reveal">
      <p>“Handmade takes time, and time is luxury.”</p>
      <cite>— Diana</cite>
    </blockquote>
  </section>

  <!-- ============ FOR SALE ============ -->
  <section class="section">
    <div class="wrap split reveal">
      <div class="split__text">
        <span class="eyebrow">Available now</span>
        <h2>Blue Bloom</h2>
        <p>
          An original painting of a pale bloom with deep teal leaves — quiet, airy and made to brighten a calm corner.
          It’s looking for a new home.
        </p>
        <dl class="specs">
          <div><dt>Size</dt><dd>50 × 70 cm</dd></div>
          <div><dt>Medium</dt><dd>Original painting</dd></div>
          <div><dt>Availability</dt><dd>One of a kind</dd></div>
        </dl>
        <div class="btn-row">
          <CommissionButton label="Enquire about this piece" variant="ghost" />
        </div>
      </div>
      <div class="split__media">
        <WorkTile work={bySlug('blue-bloom')} ratio="4 / 5" />
      </div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="section section--alt" id="about">
    <div class="wrap split split--reverse reveal">
      <div class="split__text">
        <span class="eyebrow">Meet the artist</span>
        <h2>Hi, I’m Diana</h2>
        <p>
          I’m a mural artist and painter working across London and Kent. For years I’ve been painting portraits,
          landscapes and children’s art — and teaching little ones to paint — before taking my brushes to full-size
          walls.
        </p>
        <p>
          I love the moment a plain wall turns into a place: a nursery that feels like a hug, a bedroom with a hero
          bursting through it, a window that makes people smile on their way past. Every piece is designed for you and
          painted by hand — no stencils, no prints.
        </p>
        <p class="muted">I’m an artist, not an influencer — the best way to see my work is in your own home.</p>
        <div class="btn-row">
          <CommissionButton />
          <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">Follow on Instagram</a>
        </div>
      </div>
      <div class="split__media">
        <div class="frame frame--arch about__frame">
          <img
            src={asset('media/img/diana-portrait.webp')}
            alt="Diana Deikun smiling with a paint palette beside an elephant mural in a lilac children’s room"
            style="object-position: 72% center"
            width="720"
            height="1280"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ GIVING BACK ============ -->
  <section class="section section--dark">
    <div class="wrap split reveal">
      <div class="split__text">
        <span class="eyebrow">Giving back</span>
        <h2>Art for a good cause</h2>
        <p>
          In January 2026 I took part in an exhibition and fundraiser supporting Ukrainian children affected by war —
          a wall full of colour, hope and children’s stories.
        </p>
        <p class="muted">If you’re organising a charity event or exhibition, I’d love to hear from you.</p>
      </div>
      <div class="split__media">
        <WorkTile work={bySlug('fundraiser-exhibition')} mode="reel" ratio="4 / 5" />
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section" id="faq">
    <div class="wrap faq-grid">
      <div class="reveal">
        <span class="eyebrow">FAQ</span>
        <h2>Answering your questions</h2>
        <p class="muted">Can’t find what you need? Add your question to the commission form and I’ll get back to you.</p>
      </div>
      <Faq />
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="section section--dark cta" id="contact">
    <div class="wrap center reveal">
      <span class="eyebrow">Commissions open</span>
      <h2>Have a wall in mind?</h2>
      <p class="lede">
        Tell me about your space and your ideas — it only takes a couple of minutes. I’ll reply with a first concept
        and a personalised quote.
      </p>
      <div class="btn-row">
        <CommissionButton label="Commission a mural" />
        <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">Message on Instagram</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    background: var(--bg-alt);
    padding: clamp(40px, 6vw, 80px) 0 clamp(56px, 8vw, 104px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .hero__sub {
    max-width: 520px;
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  .hero__frame {
    aspect-ratio: 3 / 4.2;
    max-height: 78vh;
    margin-left: auto;
    box-shadow: 0 30px 60px -30px rgba(31, 29, 26, 0.45);
  }

  .hero__note {
    margin: 14px 0 0;
    text-align: right;
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__frame {
      max-height: none;
      margin: 0 auto;
      max-width: 420px;
    }
    .hero__note {
      text-align: center;
    }
  }

  /* Strip */
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(220px, 24vw, 300px);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 56px var(--gutter) 40px;
    scrollbar-width: thin;
  }

  .strip :global(.strip__item) {
    scroll-snap-align: start;
  }

  /* Two images side by side */
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    align-items: start;
  }

  .duo :global(.tile:nth-child(2)) {
    margin-top: 56px;
  }

  /* Process */
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 56px 0;
    padding: 0;
  }

  .step {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .step__num {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .step h3 {
    margin: 8px 0 10px;
    font-size: 1.55rem;
  }

  .step p {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .reels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 56px;
  }

  @media (max-width: 980px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .reels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* Quote */
  .quote {
    position: relative;
    overflow: hidden;
    padding: clamp(96px, 14vw, 180px) 0;
  }

  .quote__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
  }

  .quote blockquote {
    position: relative;
    margin: 0 auto;
  }

  .quote p {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 1.2;
    max-width: 900px;
    margin: 0 auto 18px;
  }

  .quote cite {
    font-style: normal;
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--dark-muted);
  }

  /* Specs */
  .specs {
    display: grid;
    gap: 0;
    margin: 24px 0 0;
    border-top: 1px solid var(--line);
  }

  .specs div {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .specs dt {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .specs dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.2rem;
  }

  .about__frame {
    aspect-ratio: 3 / 4.2;
  }

  /* FAQ */
  .faq-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  @media (max-width: 820px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }

  .cta h2 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
  }
</style>
